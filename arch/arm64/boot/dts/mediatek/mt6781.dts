// SPDX-License-Identifier: GPL-2.0-only
/*
 * MediaTek MT6781 SoC Device Tree for Google Android Common Kernel 6.6 (GKI 2.0)
 * Audited via REA against official 6.6 prebuilt modules (.ko) and dtb.img
 */

/dts-v1/;

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/clock/mt6781-clk.h>
#include <dt-bindings/power/mt6781-power.h>
#include <dt-bindings/memory/mt6781-larb-port.h>
#include <dt-bindings/gce/mt6781-gce.h>
#include <dt-bindings/interconnect/mtk,mmqos.h>
#include <dt-bindings/interconnect/mtk,emi.h>
#include <dt-bindings/pinctrl/mt6781-pinfunc.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/iio/mt635x-auxadc.h>
#include <dt-bindings/mfd/mt6366-irq.h>
#include <dt-bindings/mmc/mt6781-msdc.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/reset/ti-syscon.h>
#include <dt-bindings/soc/mediatek,boot-mode.h>

/ {
    model = "MT6781";
    compatible = "mediatek,MT6781";
    interrupt-parent = <&gic>;
    #address-cells = <0x2>;
    #size-cells = <0x2>;
    chosen: chosen {
        bootargs = <0x636f6e73 0x6f6c653d 0x74747930 0x20726f6f 0x743d2f64 0x65762f72 0x616d2009 0x909766d 0x616c6c6f 0x633d3430 0x304d2073 0x77696f74 0x6c623d6e 0x6f666f72 0x63652074 0x72616e73 0x70617265 0x6e745f68 0x75676570 0x6167653d 0x6e657665 0x72200909 0x9696e69 0x7463616c 0x6c5f6465 0x6275673d 0x30200909 0x9383235 0x302e6e72 0x5f756172 0x74733d32 0x20090909 0x6669726d 0x77617265 0x5f636c61 0x73732e70 0x6174683d 0x2f76656e 0x646f722f 0x6669726d 0x77617265 0x20090909 0x6c6f6f70 0x2e6d6178 0x5f706172 0x743d3700>;
        kaslr-seed = <0x0 0x0>;
    };
    cluster0_opp: opp_table0 {
        compatible = "operating-points-v2";
        opp-shared;
        opp0 {
            opp-hz = <0x0 0x1dcd6500>;
            opp-microvolt = <0x927c0>;
        };
        opp1 {
            opp-hz = <0x0 0x2e224d80>;
            opp-microvolt = <0xa4cb8>;
        };
        opp2 {
            opp-hz = <0x0 0x342770c0>;
            opp-microvolt = <0xaae60>;
        };
        opp3 {
            opp-hz = <0x0 0x3a1d51c0>;
            opp-microvolt = <0xb1008>;
        };
        opp4 {
            opp-hz = <0x0 0x401332c0>;
            opp-microvolt = <0xb71b0>;
        };
        opp5 {
            opp-hz = <0x0 0x460913c0>;
            opp-microvolt = <0xbd358>;
        };
        opp6 {
            opp-hz = <0x0 0x4bfef4c0>;
            opp-microvolt = <0xc3500>;
        };
        opp7 {
            opp-hz = <0x0 0x51f4d5c0>;
            opp-microvolt = <0xc96a8>;
        };
        opp8 {
            opp-hz = <0x0 0x59682f00>;
            opp-microvolt = <0xd10ba>;
        };
        opp9 {
            opp-hz = <0x0 0x6070b880>;
            opp-microvolt = <0xd59f8>;
        };
        opp10 {
            opp-hz = <0x0 0x634d2480>;
            opp-microvolt = <0xdbba0>;
        };
        opp11 {
            opp-hz = <0x0 0x674b7b40>;
            opp-microvolt = <0xe1d48>;
        };
        opp12 {
            opp-hz = <0x0 0x6b49d200>;
            opp-microvolt = <0xe7ef0>;
        };
        opp13 {
            opp-hz = <0x0 0x6f38e680>;
            opp-microvolt = <0xef902>;
        };
        opp14 {
            opp-hz = <0x0 0x73373d40>;
            opp-microvolt = <0xf5aaa>;
        };
        opp15 {
            opp-hz = <0x0 0x77359400>;
            opp-microvolt = <0xfbc52>;
        };
    };
    cluster1_opp: opp_table1 {
        compatible = "operating-points-v2";
        opp-shared;
        opp0 {
            opp-hz = <0x0 0x2e224d80>;
            opp-microvolt = <0xa4cb8>;
        };
        opp1 {
            opp-hz = <0x0 0x31c516c0>;
            opp-microvolt = <0xa95f6>;
        };
        opp2 {
            opp-hz = <0x0 0x36c6d3c0>;
            opp-microvolt = <0xaf79e>;
        };
        opp3 {
            opp-hz = <0x0 0x3bb94e80>;
            opp-microvolt = <0xb5946>;
        };
        opp4 {
            opp-hz = <0x0 0x40abc940>;
            opp-microvolt = <0xbd358>;
        };
        opp5 {
            opp-hz = <0x0 0x45ad8640>;
            opp-microvolt = <0xc3500>;
        };
        opp6 {
            opp-hz = <0x0 0x4df67f00>;
            opp-microvolt = <0xcdfe6>;
        };
        opp7 {
            opp-hz = <0x0 0x549438c0>;
            opp-microvolt = <0xd59f8>;
        };
        opp8 {
            opp-hz = <0x0 0x5b31f280>;
            opp-microvolt = <0xdec74>;
        };
        opp9 {
            opp-hz = <0x0 0x638a2d80>;
            opp-microvolt = <0xe975a>;
        };
        opp10 {
            opp-hz = <0x0 0x674b7b40>;
            opp-microvolt = <0xef902>;
        };
        opp11 {
            opp-hz = <0x0 0x6b0cc900>;
            opp-microvolt = <0xf7314>;
        };
        opp12 {
            opp-hz = <0x0 0x6edd5900>;
            opp-microvolt = <0xfd4bc>;
        };
        opp13 {
            opp-hz = <0x0 0x729ea6c0>;
            opp-microvolt = <0x103664>;
        };
        opp14 {
            opp-hz = <0x0 0x765ff480>;
            opp-microvolt = <0x10b076>;
        };
        opp15 {
            opp-hz = <0x0 0x7a308480>;
            opp-microvolt = <0x11121e>;
        };
    };
    cpus {
        #address-cells = <0x1>;
        #size-cells = <0x0>;
        cpu0: cpu@000 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x0>;
            enable-method = "psci";
            clock-frequency = <0x77359400>;
            operating-points-v2 = <0x2>;
            dynamic-power-coefficient = <0x55>;
            capacity-dmips-mhz = <0x1ab>;
            cpu-idle-states = <0x3 0x4 0x5 0x6>;
        };
        cpu1: cpu@001 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x100>;
            enable-method = "psci";
            clock-frequency = <0x77359400>;
            operating-points-v2 = <0x2>;
            dynamic-power-coefficient = <0x55>;
            capacity-dmips-mhz = <0x1ab>;
            cpu-idle-states = <0x3 0x4 0x5 0x6>;
        };
        cpu2: cpu@002 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x200>;
            enable-method = "psci";
            clock-frequency = <0x77359400>;
            operating-points-v2 = <0x2>;
            dynamic-power-coefficient = <0x55>;
            capacity-dmips-mhz = <0x1ab>;
            cpu-idle-states = <0x3 0x4 0x5 0x6>;
        };
        cpu3: cpu@003 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x300>;
            enable-method = "psci";
            clock-frequency = <0x77359400>;
            operating-points-v2 = <0x2>;
            dynamic-power-coefficient = <0x55>;
            capacity-dmips-mhz = <0x1ab>;
            cpu-idle-states = <0x3 0x4 0x5 0x6>;
        };
        cpu4: cpu@100 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x400>;
            enable-method = "psci";
            clock-frequency = <0x77359400>;
            operating-points-v2 = <0x2>;
            dynamic-power-coefficient = <0x55>;
            capacity-dmips-mhz = <0x1ab>;
            cpu-idle-states = <0x3 0x4 0x5 0x6>;
        };
        cpu5: cpu@101 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x500>;
            enable-method = "psci";
            clock-frequency = <0x77359400>;
            operating-points-v2 = <0x2>;
            dynamic-power-coefficient = <0x55>;
            capacity-dmips-mhz = <0x1ab>;
            cpu-idle-states = <0x3 0x4 0x5 0x6>;
        };
        cpu6: cpu@102 {
            device_type = "cpu";
            compatible = "arm,cortex-a75";
            reg = <0x600>;
            enable-method = "psci";
            clock-frequency = <0x7a308480>;
            operating-points-v2 = <0x7>;
            dynamic-power-coefficient = <0x113>;
            capacity-dmips-mhz = <0x400>;
            cpu-idle-states = <0x8 0x9 0x5 0x6>;
        };
        cpu7: cpu@103 {
            device_type = "cpu";
            compatible = "arm,cortex-a75";
            reg = <0x700>;
            enable-method = "psci";
            clock-frequency = <0x7a308480>;
            operating-points-v2 = <0x7>;
            dynamic-power-coefficient = <0x113>;
            capacity-dmips-mhz = <0x400>;
            cpu-idle-states = <0x8 0x9 0x5 0x6>;
        };
        cpu-map {
            cluster0 {
                core0 {
                    cpu = <&cpu0>;
                };
                core1 {
                    cpu = <&cpu1>;
                };
                core2 {
                    cpu = <&cpu2>;
                };
                core3 {
                    cpu = <&cpu3>;
                };
                core4 {
                    cpu = <&cpu4>;
                };
                core5 {
                    cpu = <&cpu5>;
                };
                doe_dvfs_cl0: doe {
                };
            };
            cluster1 {
                core0 {
                    cpu = <&cpu6>;
                };
                core1 {
                    cpu = <&cpu7>;
                };
                doe_dvfs_cl1: doe {
                };
            };
        };
        idle-states {
            entry-method = "arm,psci";
            cpuoff_l: cpuoff_l {
                compatible = "arm,idle-state";
                arm,psci-suspend-param = <0x10001>;
                local-timer-stop;
                entry-latency-us = <0x32>;
                exit-latency-us = <0x64>;
                min-residency-us = <0x640>;
            };
            cpuoff_b: cpuoff_b {
                compatible = "arm,idle-state";
                arm,psci-suspend-param = <0x10001>;
                local-timer-stop;
                entry-latency-us = <0x32>;
                exit-latency-us = <0x64>;
                min-residency-us = <0x578>;
            };
            clusteroff_l: clusteroff_l {
                compatible = "arm,idle-state";
                arm,psci-suspend-param = <0x1010001>;
                local-timer-stop;
                entry-latency-us = <0x64>;
                exit-latency-us = <0xfa>;
                min-residency-us = <0x834>;
            };
            clusteroff_b: clusteroff_b {
                compatible = "arm,idle-state";
                arm,psci-suspend-param = <0x1010001>;
                local-timer-stop;
                entry-latency-us = <0x64>;
                exit-latency-us = <0xfa>;
                min-residency-us = <0x76c>;
            };
            mcusysoff: mcusysoff {
                compatible = "arm,idle-state";
                arm,psci-suspend-param = <0x1010002>;
                local-timer-stop;
                entry-latency-us = <0x12c>;
                exit-latency-us = <0x4b0>;
                min-residency-us = <0xfa0>;
            };
            s2idle: s2idle {
                compatible = "arm,idle-state";
                arm,psci-suspend-param = <0x1010100>;
                local-timer-stop;
                entry-latency-us = <0x1f4>;
                exit-latency-us = <0x578>;
                min-residency-us = <0xffffffff>;
            };
        };
    };
    mtk_lpm: mtk_lpm {
        compatible = "mediatek,mtk-lpm";
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        ranges;
        lpm-kernel-suspend = <0x0>;
        suspend-method = "enable";
        cpupm-method = "mcu";
        logger-enable-states = "mcusysoff";
        mcusys-cnt-chk = <0x1>;
        irq-remain = <0x12 0x13 0x14 0x15 0x16>;
        resource-ctrl = <0x17 0x18 0x19 0x1a 0x1b>;
        constraints = <0x1c 0x1d 0x1e>;
        spm-cond = <0x1f 0x20>;
        cg-shift = <0x0>;
        pll-shift = <0x10>;
        cpupm_sysram: cpupm-sysram@0011b000 {
            compatible = "mediatek,cpupm-sysram";
            reg = <0x0 0x11b000 0x0 0x500>;
        };
        mcusys_ctrl: mcusys-ctrl@0c53a000 {
            compatible = "mediatek,mcusys-ctrl";
            reg = <0x0 0xc53a000 0x0 0x1000>;
        };
        lpm_sysram: lpm_sysram@0011b500 {
            compatible = "mediatek,lpm-sysram";
            reg = <0x0 0x11b500 0x0 0x300>;
        };
        irq-remain-list {
            edge_keypad: edge_keypad {
                target = <0x21>;
                value = <0x1 0x0 0x0 0x4>;
            };
            edge_mdwdt: edge_mdwdt {
                target = <0x22>;
                value = <0x1 0x0 0x0 0x2000000>;
            };
            level_btif_tx: level_btif_tx {
                target = <0x23>;
                value = <0x0 0x1 0x0 0x0>;
            };
            level_btif_rx: level_btif_rx {
                target = <0x23>;
                value = <0x0 0x2 0x0 0x0>;
            };
            level_dsi0: level-dsi0 {
                target = <0x24>;
                value = <0x0 0x0 0x0 0x0>;
            };
        };
        resource-ctrl-list {
            bus26m: bus26m {
                id = <0x0>;
                value = <0x0>;
            };
            infra: infra {
                id = <0x1>;
                value = <0x0>;
            };
            syspll: syspll {
                id = <0x2>;
                value = <0x0>;
            };
            dram_s0: dram_s0 {
                id = <0x3>;
                value = <0x0>;
            };
            dram_s1: dram_s1 {
                id = <0x4>;
                value = <0x0>;
            };
        };
        constraint-list {
            rc_bus26m: rc_bus26m {
                rc-name = "bus26m";
                id = <0x0>;
                value = <0x1>;
                cond-info = <0x1>;
            };
            rc_syspll: rc_syspll {
                rc-name = "syspll";
                id = <0x1>;
                value = <0x1>;
                cond-info = <0x1>;
            };
            rc_dram: rc_dram {
                rc-name = "dram";
                id = <0x2>;
                value = <0x1>;
                cond-info = <0x1>;
            };
        };
        spm-cond-list {
            spm_cond_cg: spm_cond_cg {
                cg-name = "MTCMOS_0", "INFRA_0", "INFRA_1", "INFRA_2", "INFRA_3", "INFRA_4", "INFRA_5", "MMSYS_0", "MMSYS_1", "MMSYS_2", "MMSYS_3";
            };
            spm_cond_pll: spm_cond_pll {
                pll-name = "UNIVPLL", "MFGPLL", "MSDCPLL", "TVPLL", "MMPLL";
            };
        };
    };
    pmu {
        compatible = "arm,armv8-pmuv3";
        interrupt-parent = <&gic>;
        interrupts = <0x1 0x7 0x4 0x0>;
    };
    dsu-pmu-0 {
        compatible = "arm,dsu-pmu";
        interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH 0x0>;
        cpus = <0xa 0xb 0xc 0xd 0xe 0xf 0x10 0x11>;
    };
    fpsgo: fpsgo {
        compatible = "mediatek,fpsgo";
        interconnects = <&dvfsrc MTK_EMI_MASTER_MCUSYS &dvfsrc MTK_EMI_SLAVE_DDR_EMI>;
        interconnect-names = "fpsgo-perf-bw";
        required-opps = <0x26>;
        fbt-cpu-mask = <0xff 0xc0 0x3f 0x3f 0xc0 0x3f>;
        sbe-resceue-enable = <0x1>;
        boost-dram = <0x2>;
    };
    mcucfg_mp0_counter {
        compatible = "mediatek,mcucfg_mp0_counter";
        reg_mp0_counter_base = <0x27>;
    };
    memory {
        device_type = "memory";
        reg = <0x0 0x40000000 0x0 0x3e605000>;
    };
    psci {
        compatible = "arm,psci-1.0";
        method = "smc";
    };
    aliases {
        ovl0 = "/disp_ovl0@14005000";
        ovl3 = "/disp_ovl0_2l@14006000";
        rdma0 = "/disp_rdma0@14007000";
        dsi0 = "/dsi@14013000";
        ccorr0 = "/disp_ccorr0@1400b000";
    };
    mobicore: mobicore {
        compatible = "trustonic,mobicore";
        interrupts = <GIC_SPI 64 IRQ_TYPE_EDGE_RISING 0x0>;
    };
    reserved_memory: reserved-memory {
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        ranges;
        reserve-memory-sspm_share {
            compatible = "mediatek,reserve-memory-sspm_share";
            no-map;
            status = "okay";
            size = <0x0 0x510000>;
            alignment = <0x0 0x10000>;
            alloc-ranges = <0x0 0x40000000 0x0 0x60000000>;
        };
        ion-carveout-heap {
            compatible = "mediatek,ion-carveout-heap";
            no-map;
            size = <0x0 0xc000>;
            alignment = <0x0 0x1000>;
            alloc-ranges = <0x0 0x40000000 0x0 0x80000000>;
        };
        reserve-memory-adsp_share {
            compatible = "mediatek,reserve-memory-adsp_share";
            no-map;
            size = <0x0 0x1000000>;
            alignment = <0x0 0x1000>;
            alloc-ranges = <0x0 0x40000000 0x0 0x40000000>;
        };
        consys_mem: consys-reserve-memory {
            compatible = "mediatek,consys-reserve-memory";
            no-map;
            size = <0x0 0x500000>;
            alignment = <0x0 0x1000000>;
            alloc-ranges = <0x0 0x40000000 0x0 0x80000000>;
        };
        wifi_mem: wifi-reserve-memory {
            compatible = "shared-dma-pool";
            no-map;
            size = <0x0 0x600000>;
            alignment = <0x0 0x1000000>;
            alloc-ranges = <0x0 0x40000000 0x0 0x80000000>;
        };
        reserve-memory-scp_share {
            compatible = "mediatek,reserve-memory-scp_share";
            no-map;
            size = <0x0 0x320000>;
            alignment = <0x0 0x1000000>;
            alloc-ranges = <0x0 0x50000000 0x0 0x40000000>;
        };
        ssmr_cma_mem: ssmr-reserved-cma_memory {
            compatible = "shared-dma-pool";
            reusable;
            size = <0x0 0x10000000>;
            alignment = <0x0 0x1000000>;
            alloc-range = <0x0 0xc0000000 0x0 0x10000000>;
        };
        dpmaif_resv_cache_mem: ccci-dpmaif-cache-memory {
            compatible = "mediatek,dpmaif-resv-cache-mem";
            size = <0x0 0x190000>;
            alignment = <0x0 0x1000>;
            alloc-ranges = <0x0 0x40000000 0x0 0xf0000000>;
        };
        dpmaif_resv_nocache_mem: ccci-dpmaif-nocache-memory {
            compatible = "mediatek,dpmaif-resv-nocache-mem";
            no-map;
            size = <0x0 0x50000>;
            alignment = <0x0 0x1000>;
            alloc-ranges = <0x0 0x40000000 0x0 0xf0000000>;
        };
    };
    gic: interrupt-controller {
        compatible = "arm,gic-v3";
        #interrupt-cells = <0x4>;
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        #redistributor-regions = <0x1>;
        interrupt-parent = <&gic>;
        interrupt-controller;
        reg = <0x0 0xc000000 0x0 0x40000 0x0 0xc040000 0x0 0x200000>;
        interrupts = <0x1 0x9 0x4 0x0>;
    };
    clkitg: clkitg {
        compatible = "simple-bus";
    };
    clkchk {
        compatible = "mediatek,mt6781-clkchk";
    };
    clocks {
        clk_null: clk_null {
            compatible = "fixed-clock";
            #clock-cells = <0x0>;
            clock-frequency = <0x0>;
        };
        clk26m: clk26m {
            compatible = "fixed-clock";
            #clock-cells = <0x0>;
            clock-frequency = <0x18cba80>;
        };
        clk13m: clk13m {
            compatible = "fixed-clock";
            #clock-cells = <0x0>;
            clock-frequency = <0xc65d40>;
        };
        clk32k: clk32k {
            compatible = "fixed-clock";
            #clock-cells = <0x0>;
            clock-frequency = <0x7d00>;
        };
    };
    qos@0011bb80 {
        compatible = "mediatek,mt6893-qos";
        reg = <0x0 0x11bb80 0x0 0x80>;
    };
    cm_mgr: cm_mgr@c530000 {
        compatible = "mediatek,mt6781-cm_mgr";
        reg = <0x0 0xc530000 0x0 0x9000>;
        reg-names = "cm_mgr_base";
        interconnects = <&dvfsrc MTK_EMI_MASTER_MCUSYS &dvfsrc MTK_EMI_SLAVE_DDR_EMI>;
        interconnect-names = "cm-perf-bw";
        required-opps = <0x26 0x2b 0x2c 0x2d 0x2e 0x2f>;
        cm_mgr,cp_down = <0x78 0x78 0x28 0x3c>;
        cm_mgr,cp_up = <0x78 0x78 0x64 0x64>;
        cm_mgr,dt_down = <0x3 0x0 0x0 0x0>;
        cm_mgr,dt_up = <0x0 0x0 0x0 0x0>;
        cm_mgr,vp_down = <0x64 0x64 0x64 0x64>;
        cm_mgr,vp_up = <0x64 0x64 0x64 0x64>;
    };
    chipid@08000000 {
        compatible = "mediatek,chipid";
        reg = <0x0 0x8000000 0x0 0x4 0x0 0x8000004 0x0 0x4 0x0 0x8000008 0x0 0x4 0x0 0x800000c 0x0 0x4>;
    };
    topckgen: topckgen@10000000 {
        compatible = "mediatek,topckgen", "mediatek,mt6781-topckgen", "syscon";
        reg = <0x0 0x10000000 0x0 0x1000>;
        #clock-cells = <0x1>;
    };
    infracfg_ao: infracfg_ao@10001000 {
        compatible = "mediatek,common-infracfg_ao", "mediatek,mt6781-infracfg_ao", "mediatek,infracfg_ao", "syscon", "simple-mfd";
