    aw8622 {
        compatible = "awinic,aw8622";
        hwen-gpio = <&pio 173 GPIO_ACTIVE_HIGH>;
        pwm_ch = <0x0>;
        waveform_sample_period = <0xa2c2>;
        center_freq = <0xd0>;
        default_pwm_freq = <0x6590>;
        pinctrl-names = "haptic_gpio_aw8622_default", "haptic_gpio_aw8622_set";
        pinctrl-0 = <&haptic_gpio_aw8622_default>;
        pinctrl-1 = <&haptic_gpio_aw8622_set>;
        status = "okay";
    };
